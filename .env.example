# Copy to .env before running `make up`.
# Every value below has a default in src/config.ts; the ones that matter for
# Docker are the service hostnames (redis/postgres), which differ from localhost.

# --- API ---------------------------------------------------------------------
PORT=3000
LOG_LEVEL=info
API_PORT=3000

# --- Redis -------------------------------------------------------------------
# Inside the compose network the host is the service name, not localhost.
REDIS_URL=redis://redis:6379
REDIS_PORT=6379
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_RECONNECT_MAX_DELAY_MS=3000

# --- Postgres ----------------------------------------------------------------
# DATABASE_URL is set by docker-compose.yml for the api service and overrides
# anything here; this value is what `yarn dev` uses outside Docker.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/stocktracker
POSTGRES_PORT=5433
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_STARTUP_RETRIES=10
PG_STARTUP_RETRY_DELAY_MS=1000

# --- brapi -------------------------------------------------------------------
# Note: docker-compose.yml sets BRAPI_BASE_URL for the api service, which
# overrides this value; it matters for `yarn dev` outside Docker.
BRAPI_BASE_URL=https://brapi.dev/api
# Free tier works without a token but is heavily rate limited.
# Get one at https://brapi.dev/dashboard
BRAPI_TOKEN=
BRAPI_TIMEOUT_MS=5000
BRAPI_RETRY_COUNT=3
BRAPI_RETRY_BASE_DELAY_MS=1000

# --- Quotes cache ------------------------------------------------------------
QUOTE_CACHE_TTL=60
QUOTE_CACHE_PREFIX=quote:
QUOTE_MAX_SYMBOLS=10

# --- Alerts poller -----------------------------------------------------------
ALERTS_POLLER_ENABLED=true
ALERTS_POLLER_INTERVAL_MS=60000
ALERTS_BATCH_SIZE=100
ALERTS_LOCK_KEY=alerts_poller_lock

# --- Notifications -----------------------------------------------------------
WEBHOOK_TIMEOUT_MS=5000
# A webhook destination is attacker-chosen, so it is validated on write and
# again before every delivery (src/lib/webhookUrl.ts). Defaults refuse anything
# that is not public https.
WEBHOOK_ALLOWED_SCHEMES=https
# Comma-separated hosts that bypass the private-range check. Use this to reach
# an internal collector; when set, ONLY these hosts are accepted.
WEBHOOK_ALLOWED_HOSTS=
# Development escape hatch: skips the private/loopback/link-local check so a
# local receiver works. Never enable where untrusted callers can create alerts.
WEBHOOK_ALLOW_PRIVATE=false

# --- Auth --------------------------------------------------------------------
# The one variable with NO default: src/config.ts throws on boot if it is
# missing, so a signing secret can never silently reach production. Generate a
# real one with:  openssl rand -base64 48
JWT_SECRET=
# Seconds a token stays valid. There is no revocation, so keep this short.
JWT_TTL_SECONDS=3600
